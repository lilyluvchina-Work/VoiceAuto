# TTS provider: webspeech | doubao
VITE_TTS_PROVIDER=doubao

# Doubao TTS config
VITE_DOUBAO_TTS_URL=https://openspeech.bytedance.com/api/v1/tts
VITE_DOUBAO_APP_ID=your_app_id
VITE_DOUBAO_ACCESS_TOKEN=your_access_token
VITE_DOUBAO_CLUSTER=volcano_tts
VITE_DOUBAO_VOICE_TYPE=zh_female_roumei_moon_bigtts
VITE_DOUBAO_UID=voiceauto-web

# DingTalk robot notification config
VITE_DINGTALK_ENABLED=true
VITE_DINGTALK_PROXY_PATH=/dingtalk-robot
VITE_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_access_token
VITE_DINGTALK_ACCESS_TOKEN=your_access_token
VITE_DINGTALK_SECRET=your_dingtalk_sign_secret
